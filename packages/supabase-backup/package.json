{
  "name": "@pixpilot/supabase-backup",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.0",
  "author": "Mo Doaie <m.doaie@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/pixpilot/supabase-toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixpilot/supabase-toolkit.git",
    "directory": "packages/supabase-backup"
  },
  "bugs": {
    "url": "https://github.com/pixpilot/supabase-toolkit/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": "./src/index.ts",
  "bin": {
    "supabase-backup": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "pnpm clean && git clean -xdf node_modules",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui --watch",
    "test:ui:coverage": "vitest --ui --coverage --watch --hookTimeout=30000 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/tsdown-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:dev",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "eslint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@internal/prettier-config"
}
